-- [[ ADVANCED NPC BYPASS & ANTI-HIT SYSTEM ]] --

local AntiHitEnabled = false
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local LocalPlayer = Players.LocalPlayer

local HeartbeatConn = nil

-- Function para i-disable ang Aggro at Touch Damage ng Monsters
local function ApplyBypass()
	local char = LocalPlayer.Character
	if not char then return end

	-- 1. Anti-Touch / Hitbox Immunity sa Player
	for _, part in pairs(char:GetChildren()) do
		if part:IsA("BasePart") then
			part.CanTouch = false
		end
	end

	-- 2. Freeze / Bypass Monster Agro (Disable Monster Hitboxes)
	for _, model in pairs(workspace:GetChildren()) do
		if model:IsA("Model") and model ~= char and model:FindFirstChildOfClass("Humanoid") then
			for _, part in pairs(model:GetChildren()) do
				if part:IsA("BasePart") then
					part.CanTouch = false
					part.CanCollide = false
				end
			end
		end
	end
end

-- Optimized Loop (Tumatakbo nang walang Lag)
local function EnableSystem()
	if HeartbeatConn then HeartbeatConn:Disconnect() end
	
	HeartbeatConn = RunService.Heartbeat:Connect(function()
		if AntiHitEnabled then
			ApplyBypass()
		end
	end)
end

local function DisableSystem()
	if HeartbeatConn then
		HeartbeatConn:Disconnect()
		HeartbeatConn = nil
	end
	
	local char = LocalPlayer.Character
	if char then
		for _, part in pairs(char:GetChildren()) do
			if part:IsA("BasePart") then
				part.CanTouch = true
			end
		end
	end
end

-- Button Logic
AntiHitButton.MouseButton1Click:Connect(function()
	AntiHitEnabled = not AntiHitEnabled
	if AntiHitEnabled then
		AntiHitButton.Text = "ANTI HIT: ON"
		AntiHitButton.TextColor3 = Color3.fromRGB(85, 255, 127)
		AntiHitButton.BackgroundColor3 = Color3.fromRGB(25, 55, 35)
		StatusLabel.Text = "ACTIVATING ANTI HIT V1..."
		StatusLabel.TextColor3 = Color3.fromRGB(85, 255, 127)
		EnableSystem()
	else
		AntiHitButton.Text = "ANTI HIT: OFF"
		AntiHitButton.TextColor3 = Color3.fromRGB(255, 85, 85)
		AntiHitButton.BackgroundColor3 = Color3.fromRGB(35, 35, 45)
		StatusLabel.Text = "STATUS: DISABLED"
		StatusLabel.TextColor3 = Color3.fromRGB(180, 180, 180)
		DisableSystem()
	end
end)

